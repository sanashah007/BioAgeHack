# Copy to .env and fill in. .env is gitignored -- never commit the real one.
#
#   cp .env.example .env
#
# The API key itself does NOT go in this file -- it lives in the OS
# credential store: python scripts/set_key.py

# RECOMMENDATIONS_PROVIDER selects which SDK/wire format is used.
# Default (if unset): openai_compatible.
#
#   openai_compatible -- any OpenAI-compatible endpoint: real OpenAI,
#     OpenRouter's native endpoint, Google AI Studio / Gemini. One code path
#     for all of them; only base_url/api_key/model change below.
#   anthropic         -- the Anthropic SDK direct, or a gateway that speaks
#     its wire format (e.g. OpenRouter's Anthropic-compatible endpoint).
#     Live-verified end to end; keeps Claude's adaptive-thinking/effort tuning.
#
# RECOMMENDATIONS_PROVIDER=openai_compatible

# --- openai_compatible: real OpenAI -----------------------------------------
# Leave RECOMMENDATIONS_BASE_URL unset. Uses OPENAI_API_KEY if
# RECOMMENDATIONS_API_KEY / the credential store are both empty.
# RECOMMENDATIONS_MODEL=<an OpenAI model id>

# --- openai_compatible: OpenRouter's native endpoint ------------------------
# Note the /v1 and the different host path vs. the Anthropic-compatible
# endpoint below -- these are two different OpenRouter endpoints.
# RECOMMENDATIONS_BASE_URL=https://openrouter.ai/api/v1
# RECOMMENDATIONS_MODEL=anthropic/claude-sonnet-5   # or any model OpenRouter lists

# --- openai_compatible: Google AI Studio / Gemini ---------------------------
# Live-verified with gemini-3.6-flash. Get a key from https://aistudio.google.com.
# Google retires model ids from time to time -- if the configured one 404s,
# the error response names the current replacement (that's how
# gemini-2.5-flash -> gemini-3.6-flash was found here).
# RECOMMENDATIONS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# RECOMMENDATIONS_MODEL=gemini-3.6-flash

# --- anthropic: direct to Anthropic -----------------------------------------
# RECOMMENDATIONS_PROVIDER=anthropic
# Leave RECOMMENDATIONS_BASE_URL unset.
# RECOMMENDATIONS_MODEL=claude-sonnet-5

# --- anthropic: via OpenRouter's Anthropic-compatible endpoint -------------
# Live-verified. Note this is a different path from the openai_compatible
# OpenRouter entry above -- no /v1, different host path.
# RECOMMENDATIONS_PROVIDER=anthropic
# RECOMMENDATIONS_BASE_URL=https://openrouter.ai/api
# RECOMMENDATIONS_MODEL=anthropic/claude-sonnet-5

# --- Effort, any provider ---------------------------------------------------
# low | medium | high | xhigh | max (xhigh/max only meaningful for Anthropic;
# clamped to "high" for openai_compatible's reasoning_effort). Default: medium.
RECOMMENDATIONS_EFFORT=medium
