# Downloaded source data -- 3.3 GB, all publicly redistributable from CDC/GEO.
# Deliberately NOT committed: it is large, it is not ours, and every byte is
# reproducible by `python scripts/run_pipeline.py`, which caches on first run.
data/raw/

# Regenerated by every pipeline run (3.2 MB of intermediates).
data/interim/

# EXCEPTION: data/processed is committed (332 KB). It holds the fitted combiner
# and the out-of-fold scores, which is all `scripts/bioage_report.py` needs --
# so the demo runs straight after clone without a 3.3 GB download. Derived
# entirely from NHANES/NCHS public-use files, which are de-identified,
# age-top-coded and freely redistributable.
!data/processed/

# Python environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipython/
.ipynb_checkpoints/

# Biolearn caches the parsed GSE40279 matrix (~2.7 GB) outside the repo, but
# guard against a stray local copy.
*.pkl.gz
bio-learn/

# OS / editor
.DS_Store
.vscode/
.idea/

# Pipeline run artifacts that are regenerated every run.
# NOTE: outputs/figures and outputs/tables ARE committed -- they are the
# deliverable, and reviewing the result should not require a 3.3 GB download.
outputs/logs/
